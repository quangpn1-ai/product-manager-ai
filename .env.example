# Application
NODE_ENV=development
PORT=3000
BASE_URL=http://localhost:3000
LOG_LEVEL=info

# Database
DATABASE_URL=postgres://aipm:aipm@localhost:5432/aipm

# Redis
REDIS_URL=redis://localhost:6379

# Authentication
JWT_SECRET=your-secret-key-change-in-production
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

# Encryption (32 bytes in hex or base64)
APP_KMS_MASTER_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# Managed AI Provider Keys (optional - for platform-managed mode)
MANAGED_OPENAI_KEY=
MANAGED_ANTHROPIC_KEY=
MANAGED_GOOGLE_KEY=

# Rate Limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100
AUTH_RATE_LIMIT_MAX=5
